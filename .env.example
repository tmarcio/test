# ==========================================
# Aliado Food — variáveis de ambiente
# Copia para .env e ajusta
# ==========================================

# URL pública do site (usada em links de rastreio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Painel de administração (/admin)
# IMPORTANTE: troca em produção
ADMIN_PASSWORD=aliado2024
ADMIN_SECRET=troca-este-texto-por-uma-frase-secreta-longa

# E-mail (SMTP) — opcional
# Sem SMTP, as notificações (encomendas + candidaturas) ficam registadas na base de dados
# e na consola do servidor; e-mails são enviados apenas com SMTP configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aliado Food <aliadofood@hotmail.com>

# Base de dados SQLite (opcional — por defeito data/aliado-food.db)
# DB_FILE=/caminho/para/aliado-food.db
